+					       qm_port->gen_bit, false);
+
+	if (ret == EPERM)
+		DLB2_LOG_LINE_DBG("dlb2: Not enough interupts available (for VF)");
+
+	/* If the CQ int ioctl was unsuccessful, the interrupt remains armed */
+	qm_port->int_armed = (ret != 0);
