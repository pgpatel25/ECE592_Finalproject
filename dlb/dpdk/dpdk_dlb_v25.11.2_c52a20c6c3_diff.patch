+	ret = ioctl(dlb2_domain_fd[handle->device_id][handle->domain_id],
+		    DLB2_IOC_ENABLE_CQ_WEIGHT, (unsigned long)args);
+
+	return (ret != 0) ? -errno : 0;
+}
