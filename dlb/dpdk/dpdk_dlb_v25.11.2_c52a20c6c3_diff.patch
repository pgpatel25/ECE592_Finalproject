+	NUMA_NODE_ARG "=<int> "
+	DLB2_MAX_NUM_EVENTS "=<int> "
+	DLB2_NUM_DIR_CREDITS "=<int> "
+	DLB2_NUM_ORDERED_QUEUES_0 "=<int> "
+	DLB2_NUM_ORDERED_QUEUES_1 "=<int> "
+	HWDEV_ID_ARG "=<int> "
+);
