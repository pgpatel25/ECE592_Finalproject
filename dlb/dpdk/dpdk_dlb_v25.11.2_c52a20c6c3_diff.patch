+#define PCT_STR_LEN 5
+static void
+format_percent_str(float pct, char *str)
+{
+	if (pct > 0.0f && pct < 1.0f)
+		snprintf(str, PCT_STR_LEN, " <1%%");
+	else
+		snprintf(str, PCT_STR_LEN, "%3.0f%%", pct);
+}
